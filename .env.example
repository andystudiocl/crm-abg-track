# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del CRM (sin / final), ej. https://crm.abgcarboutique.cl
APP_URL=http://localhost:3000
# Origen del sitio web existente que consume la API pública (CORS), ej. https://www.abgcarboutique.cl
SITE_ORIGIN=https://www.abgcarboutique.cl

# Meta (Lead Ads + WhatsApp comparten app)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Google Calendar (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
